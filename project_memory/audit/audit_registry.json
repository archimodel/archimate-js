{
  "version": "1.0",
  "description": "Audit-Driven Development registry. Rules are the living spec.",
  "rules": [
    {
      "id": "audit.git.status",
      "description": "実行前後に git status を確認する",
      "when": [
        "pre_loop",
        "pre_commit"
      ],
      "severity": "major",
      "command": "git status --short --branch",
      "expect": {
        "exit_code": 0
      },
      "artifacts": []
    },
    {
      "id": "audit.tests.language",
      "description": "ArchiMate language profile and migration tests pass",
